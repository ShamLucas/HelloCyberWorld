services:
  openwebui:
    image: {{ openwebui_image }}
    container_name: openwebui
    restart: unless-stopped
    ports:
      - "{{ openwebui_bind_address }}:{{ openwebui_host_port }}:8080"
    volumes:
      - openwebui_data:/app/backend/data
    networks:
      - internal

volumes:
  openwebui_data:
    name: {{ openwebui_volume_name }}

networks:
  internal:
    external: true
    name: {{ docker_network_name }}